# Copie ce fichier en « .env » (dans ce dossier) et remplis les valeurs. Ne commite JAMAIS le fichier .env.

# Nom de domaine du site, sans https:// (ex. g2l.example). Il doit pointer vers l'adresse IP du VPS.
SITE_DOMAIN=

# Base de données. Génère un mot de passe avec :  openssl rand -hex 24
POSTGRES_DB=g2l
POSTGRES_USER=g2l
POSTGRES_PASSWORD=

# Mentions légales du site avec comptes : le build du site REFUSE de se terminer sans ces trois valeurs.
# (Elles sont publiées dans les mentions légales : adresse de contact pour les droits RGPD, et hébergeur du VPS.)
LEGAL_CONTACT_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
